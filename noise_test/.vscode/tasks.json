{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "LaTeX: pdflatex build",
            "type": "shell",
            "command": "pdflatex",
            "args": [
                "-file-line-error",
                "-halt-on-error",
                "-interaction=nonstopmode",
                "-synctex=1",
                "noise_plots.tex"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": ["$latex"]
        }
    ]
}
